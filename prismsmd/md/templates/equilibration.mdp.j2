; {{ title }}
define       = {{ define }}
;
integrator   = md
dt           = {{ dt }}
nsteps       = {{ nsteps }}
;
nstxtcout     = {{ nstxtcout }}
xtc-precision = 10000
;
; Atom group written to the xtc. Unset (the default) means all atoms.
;   Non-Water cuts the trajectory size by about 86%, at the cost of making any
;   later water analysis impossible. The old GROMACS name is xtc-grps, and the
;   group must exist in the index.ndx given to grompp.
{% if compressed_x_grps %}compressed-x-grps = {{ compressed_x_grps }}
{% endif %}nstlog        = {{ nstlog }}
nstenergy     = {{ nstenergy }}
;
nstlist      = 5
ns_type      = grid
pbc          = {{ pbc }}
;
coulombtype  = PME
; Cutoffs are stated explicitly rather than left to the GROMACS default of 1.0 nm.
; Keep them equal to the nonbondedCutoff of createSystem
; (protocol.nonbonded_cutoff_angstrom). rlist is not written: under the Verlet
; scheme it follows from verlet-buffer-tolerance.
rvdw            = 1.0
rcoulomb        = 1.0
;
vdwtype      = cut-off
dispcorr     = EnerPres
;
tcoupl       = v-rescale
tc_grps      = Non-Water Water
tau_t        = 0.1 0.1
ref_t        = {{ temperature }} {{ temperature }}
;
pcoupl       = {{ pcoupl }}
pcoupltype   = isotropic
compressibility = 4.5e-5
ref_p        = {{ pressure }}
refcoord_scaling = all
;
gen_vel = no
;
continuation = yes
constraints  = hbonds
constraint_algorithm = LINCS
