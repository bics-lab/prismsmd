#!/bin/sh
# GROMACS run script generated by prismsmd.md.runner.
#
# The resume mechanism:
#   [1] compute -maxh per stage from the job's remaining time
#   [2] never delete the .cpt / .tpr of an unfinished stage
#   [3] continue with -cpi -append when a .cpt exists
#   [4] judge completion by the presence of the .gro, not by the exit code
#       (mdrun returns exit 0 even when cut short by -maxh)
#   [5] leave without starting a stage when there is not enough time left
#
# The caller (the job script) may export:
#   JOB_START : job start time (date +%s)
#   HRT_SEC   : the wall-clock limit in seconds
#   TAIL_SEC  : seconds to reserve for post-processing
#   GPU_ID    : logical number of the GPU to use (left to GROMACS if omitted)
#   PIN_OFFSET: first CPU of this run's share, for GROMACS' -pinoffset
#   PIN_STRIDE: CPUs between consecutive threads, for -pinstride (default 1)
# Safe defaults apply when they are unset.
#
# GPU_ID selects the device through GROMACS' -gpu_id. Leave it unset to keep whatever
# device selection the environment already has.
#
# PIN_OFFSET turns on GROMACS' thread pinning. Which CPUs this run may use, and which
# of them are local to its GPU, depend on the machine and on what the scheduler handed
# out, so the number is computed outside and passed in. Leave it unset to let GROMACS
# decide, and note that it warns about running several jobs unpinned.

# How the thread count is given depends on which GROMACS build this is, and no single
# option works for both:
#
#   thread-MPI  -nt N     bounds the total. -ntomp N alone does NOT: GROMACS then picks
#                         the rank count itself and fills the machine (measured: -ntomp 2
#                         gave 12 ranks x 2 threads on a 24-core host).
#   MPI         -ntomp N  is the only one accepted; -nt stops with "Setting the total
#                         number of threads is only supported with thread-MPI".
#
# So the binary is asked which it is, rather than guessed at from its name.

set -u

hostname
ncpus=${1:-1}

top={{ top }}
initial_gro={{ gro }}
now={{ gro_basename }}

if [ -z "${GMX:-}" ]; then
    GMX={{ gmx }}
fi

: ${JOB_START:=$(date +%s)}
: ${HRT_SEC:={{ hrt_sec }}}
: ${TAIL_SEC:={{ tail_sec }}}
: ${MIN_RUN_SEC:={{ min_run_sec }}}

# If GPU_ID was passed, this script owns the device selection, so drop any competing
# one: CUDA_VISIBLE_DEVICES renumbers the devices, after which -gpu_id counts within
# what is left and points somewhere else than intended. Without GPU_ID the
# environment's own selection is left exactly as it is.
GPU_OPT=""
if [ -n "${GPU_ID:-}" ]; then
    GPU_OPT="-gpu_id ${GPU_ID}"
    unset CUDA_VISIBLE_DEVICES
fi

case "$("$GMX" --version 2>/dev/null | grep -i '^MPI library:')" in
    *thread_mpi*) NT_OPT="-nt ${ncpus}" ;;
    *)            NT_OPT="-ntomp ${ncpus}" ;;
esac
echo "threads: $NT_OPT"

# Pin this run's threads to the CPUs it was given. Passed in, never worked out here.
PIN_OPT=""
if [ -n "${PIN_OFFSET:-}" ]; then
    PIN_OPT="-pin on -pinoffset ${PIN_OFFSET} -pinstride ${PIN_STRIDE:-1}"
fi

remaining_seconds() {
    _elapsed=$(( $(date +%s) - JOB_START ))
    echo $(( HRT_SEC - _elapsed - TAIL_SEC ))
}

finished_info={{ finished_list }}
touch "$finished_info"

for stepname in {{ step_names }}
do
    prev=$now
    now=$stepname

    if grep -qx "${now}" "$finished_info"; then
        echo "skip: ${now} (already complete)"
        continue
    fi

    # [5] Leave without touching anything if there is not enough time left
    remain=$(remaining_seconds)
    if [ "$remain" -le "$MIN_RUN_SEC" ]; then
        echo "time up: leaving ${now} for next time (${remain} s left)"
        exit 0
    fi
    maxh=$(awk "BEGIN{printf \"%.4f\", $remain/3600}")
    echo "step ${now}: ${remain} s left -> -maxh ${maxh}"

    # [2] Keep the .cpt and .tpr. No .cpt means not started, so rebuild the .tpr too.
    rm -f "${now}.out.mdp" "${now}.trr"
    if [ ! -f "${now}.cpt" ]; then
        rm -f "${now}.tpr" "${now}.log" "${now}.gro" "${now}.edr"
    fi

    if [ ! -f "${now}.tpr" ]; then
        echo "$GMX grompp -maxwarn 1 -f ${now}.mdp -o ${now}.tpr -c ${prev}.gro -p ${top} -r ${initial_gro} -n {{ index_ndx }}"
        $GMX grompp -maxwarn 1 -f "${now}.mdp" -o "${now}.tpr" \
            -c "${prev}.gro" -p "${top}" \
            -r "${initial_gro}" -n {{ index_ndx }} || exit 1
    fi

    # [3] Continue when a .cpt exists
    CPI=""
    if [ -f "${now}.cpt" ]; then
        CPI="-cpi ${now}.cpt -append"
        echo "resume: ${now} from ${now}.cpt"
    fi

    echo "$GMX mdrun $NT_OPT $GPU_OPT $PIN_OPT -v -s ${now}.tpr $CPI -maxh $maxh -cpo ${now}.cpt -x ${now}.xtc -c ${now}.gro -e ${now}.edr -g ${now}.log"
    # shellcheck disable=SC2086
    # shellcheck disable=SC2086
    $GMX mdrun $NT_OPT $GPU_OPT $PIN_OPT -v -s "${now}.tpr" $CPI -maxh "$maxh" \
        -cpo "${now}.cpt" -x "${now}.xtc" -c "${now}.gro" \
        -e "${now}.edr" -g "${now}.log" || exit 1

    # [4] The .gro appears only on reaching nsteps
    if [ -f "${now}.gro" ]; then
        echo "$now" >> "$finished_info"
    else
        echo "not finished: ${now} (will resume with -cpi next time)"
        exit 0
    fi
done

ln -sf "$stepname.xtc" {{ out_traj }}
echo "all steps finished"
