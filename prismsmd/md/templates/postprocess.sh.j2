#!/bin/sh
# Trajectory preprocessing script generated by prismsmd.md.runner.
#
# Two stages have to happen before a PMAP can be taken, and neither may be skipped:
#
#   [1] periodic-boundary handling -> this script, gmx trjconv.
#       Produces coordinates in which molecules are whole and the protein sits at the
#       centre of the box.
#   [2] CA best-fit onto the reference structure -> done per frame by
#       FixedGridAnalysis in prismsmd/pmap_cosolvkit.py (align=True is the default).
#
# Forgetting [1] breaks the fit in [2]. That omission is detected from a physical
# quantity: the PMAP stage measures the largest intramolecular atom distance of the
# probe molecules per frame and stops with TrajectoryNotUnwrappedError on a value
# impossible for an intact molecule.
#
# The {{ traj_out }}{{ marker_suffix }} written below is a provenance record, not the
# basis of any decision.
set -eu

if [ -z "${GMX:-}" ]; then
    GMX={{ gmx }}
fi

tpr={{ tpr }}
traj_in={{ traj_in }}
traj_out={{ traj_out }}
index={{ index_ndx }}
group={{ group }}
center_group={{ center_group }}

# -pbc cluster runs first, unconditionally, monomer or multimer.
#
#   -pbc mol keeps each *molecule* whole and puts its centre in the box. That is
#   per-molecule, so nothing ties separate molecules together and nothing guarantees
#   the group being fitted ends up in one piece: a multimer's chains are separate
#   molecules and can wrap to the far side of the box, and any crystal water or ion in
#   the fit group is a separate molecule too.
#
#   -pbc cluster gathers the molecules of the chosen group into one connected object,
#   which is what -center and the later Kabsch fit assume. On a system that is already
#   whole it leaves the coordinates unchanged, so applying it everywhere costs time but
#   never changes a correct result, and there is no second code path to rot.
#
#   It has to run before -pbc mol, which is what re-images each molecule into the box;
#   clustering afterwards would have nothing left to gather.
#
# -center is required, not optional. -pbc mol alone leaves the protein wherever it
#   drifted to, and after the fit onto the reference the probes end up piled on one
#   side of it rather than surrounding it. -center puts center_group at the box centre
#   and re-images every molecule around it.
#
# Both -center and -pbc cluster read TWO groups from stdin: first the group to centre
#   on or cluster, then the group to write. Feeding only one silently uses it for both
#   and the output ends up protein-only.
#
# -pbc mol/cluster need bond information, so -s takes the .tpr; a .gro will not do.
# The output group is System, so both probes and water are kept.
traj_clustered="${traj_out%.xtc}_clustered.xtc"
echo "$GMX trjconv -s $tpr -f $traj_in -o $traj_clustered -n $index -pbc cluster"
printf '%s\n%s\n' "$center_group" "$group" | $GMX trjconv \
    -s "$tpr" -f "$traj_in" -o "$traj_clustered" \
    -n "$index" -pbc cluster
echo "$GMX trjconv -s $tpr -f $traj_clustered -o $traj_out -n $index -pbc mol -center"
printf '%s\n%s\n' "$center_group" "$group" | $GMX trjconv \
    -s "$tpr" -f "$traj_clustered" -o "$traj_out" \
    -n "$index" -pbc mol -center
# The intermediate is the same size as the input, so drop it once the second pass has
# produced its output. Keep it if the second pass failed: it is then the only evidence
# of what went wrong.
if [ -s "$traj_out" ]; then
    {{ python }} -c "
import pathlib, sys
p = pathlib.Path(sys.argv[1])
if p.is_file():
    p.unlink()
    print('[postprocess] removed the clustered intermediate', p.name)
" "$traj_clustered"
fi

# Leave a provenance record. Not for decisions: the PMAP stage decides from the
# coordinates.
{{ python }} -c "
import sys
from prismsmd.pmap_cosolvkit import write_pbc_marker
print(write_pbc_marker(sys.argv[1], sys.argv[2]))
" "$traj_out" "gmx trjconv -s $tpr -f $traj_in -o $traj_clustered -n $index -pbc cluster (center=$center_group) ; gmx trjconv -s $tpr -f $traj_clustered -o $traj_out -n $index -pbc mol -center (center=$center_group)"

echo "postprocess finished: $traj_out"
